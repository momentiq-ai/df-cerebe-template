# ─────────────────────────────────────────────────────────────────────────────
# DF Cerebe — environment template.
#
# LOCAL DEV:  copy to `.env` (in this root dir) and fill in. Workspace scripts
#             use `--env-file ../.env` so Bun loads this file from within each
#             sub-package; no dotenv needed.
# PRODUCTION: do NOT ship a .env. Doppler injects these at runtime
#             (`doppler run -- <cmd>`). See docs/getting-started.md Step 4.
#
# NOTE(verify): every key below is referenced from code or config. If you add a
# new secret, add it here too — `.env.example` is the contract for what the app
# needs. Never put real values in this file; it is the ONLY env file committed.
# ─────────────────────────────────────────────────────────────────────────────

# --- Backend (Hono + LangGraph.js) ---
PORT=8787
NODE_ENV=development

# --- Conversation transcript store (@libsql/client + Drizzle; docs/design §7.5) --
# Chat sidebar/history. NOT the agent's memory (Cerebe owns memory).
# Local dev:  file:./df-cerebe.db  (default — local SQLite, no token needed)
# Turso/prod: libsql://your-db-name.turso.io  + TURSO_AUTH_TOKEN
DATABASE_URL=file:./df-cerebe.db
TURSO_AUTH_TOKEN=

# --- LLM / cognitive engine ---------------------------------------------------
# Default: Cerebe (Momentiq's cognitive engine) via its OpenAI-compatible chat
# endpoint, driven by @langchain/openai. The agent (backend/src/agent) calls this.
# Get a key at https://cerebe.ai (keys look like ck_live_...).
CEREBE_API_KEY=
CEREBE_PROJECT=                                        # optional Cerebe project id
# OpenAI-compatible endpoint (chat path, @langchain/openai). Correct as-is.
CEREBE_BASE_URL=https://api.cerebe.ai/api/v1/openai/v1
# NATIVE Cerebe API base (memory path, @cerebe/sdk). DISTINCT from CEREBE_BASE_URL
# above — same key, different base. Leave as-is; the memory client uses this, not
# the OpenAI-compatible URL. Only the memory features (docs/design) need it.
CEREBE_API_BASE_URL=https://api.cerebe.ai
# Model — an OpenAI-style id; Cerebe routes by capability behind it. Default verified.
LLM_MODEL=gpt-4o

# Alternative engine: raw Anthropic Claude. To use it, `bun add @langchain/anthropic`,
# swap ChatOpenAI -> ChatAnthropic in backend/src/agent/graph.ts (docs/notes.md §4),
# then set:
# ANTHROPIC_API_KEY=

# --- Clerk (auth) — graceful-optional -----------------------------------------
# Auth is implemented but OFF until you set these. Leave BOTH blank to run open
# (dev/prototype); set BOTH (from the Clerk dashboard) to enforce sign-in.
# Backend verifies tokens with the SECRET key; frontend uses the PUBLISHABLE key.
# See docs/getting-started.md Step 4.
CLERK_SECRET_KEY=
# Frontend var — Vite only exposes vars prefixed with VITE_ to the browser bundle.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Frontend → backend wiring ------------------------------------------------
# The Svelte SPA calls the backend at this base URL. In dev both run natively on
# localhost; in prod this is the deployed backend origin (set via Doppler).
VITE_API_BASE_URL=http://localhost:8787

# --- Doppler (optional, prod secrets) -----------------------------------------
# Not a runtime var the app reads — listed so the reader knows Doppler is the
# production secrets path. `doppler setup` binds this dir to a project; then
# `doppler run -- bun run dev:backend` injects everything above. docs Step 4.
